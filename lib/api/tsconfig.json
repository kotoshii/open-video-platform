{
	"extends": "../../tsconfig-base.json",
	"compilerOptions": {
		"baseUrl": ".",
		"outDir": "./dist",
		"rootDir": ".",
		"composite": true,
		"experimentalDecorators": true,
		"paths": {
			"~common/*": ["./common/*"],
			"~config/*": ["./config/*"],
			"~database/*": ["./database/*"],
			"~grpc/*": ["./grpc/*"],
			"~logging/*": ["./logging/*"],
			"~validation/*": ["./validation/*"]
		}
	},
	"tsc-alias": {
		"replacers": {
			"base-url": {
				"enabled": false
			}
		}
	},
	"references": [
		{
			"path": "../common"
		}
	]
}
