{
	"extends": "../../tsconfig-base.json",
	"compilerOptions": {
		"baseUrl": ".",
		"outDir": "./dist",
		"rootDir": ".",
		"composite": true,
		"paths": {
			"~constants/*": ["./constants/*"],
			"~types/*": ["./types/*"],
			"~utils/*": ["./utils/*"]
		}
	},
	"tsc-alias": {
		"replacers": {
			"base-url": {
				"enabled": false
			}
		}
	}
}
