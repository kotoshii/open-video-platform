# Copy this file and name it .env.api-gateway.local
----

# Values:

TUS_WEBHOOK_SECRET=tus-webhook-secret

# HOST_IP is a workaround to make Nginx in WSL-based Docker container proxy requests to API services running on the host machine.
# For WSL users, set your WSL IP (run "cat /etc/resolv.conf | grep nameserver | awk '{print $2}'" in WSL terminal);
# For non-WSL users, just set it to 127.0.0.1;
HOST_IP=127.0.0.1