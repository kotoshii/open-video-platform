{	"javascript": {		"parser": {			"unsafeParameterDecoratorsEnabled": true		}	},	"formatter": {		"lineWidth": 120	},	"linter": {		"rules": {			"recommended": true,			"correctness": {				"noUnusedImports": {					"fix": "safe",					"level": "warn",					"options": {}				}			},			"style": {				"useImportType": "off",				"useExportType": "off"			},			"complexity": {				"noStaticOnlyClass": "off"			}		}	},	"assist": {		"actions": {			"recommended": true,			"source": {				"useSortedAttributes": "on",				"useSortedProperties": "on",				"organizeImports": {					"options": {						"groups": [":NODE:", ":BLANK_LINE:", ":PACKAGE:", ":BLANK_LINE:", ":ALIAS:"]					},					"level": "on"				}			}		}	}}